# SQLite database file location
DATABASE_PATH=./data/studygraph.db

# Secret used to sign/verify auth JWTs. Change this in any real deployment.
JWT_SECRET=change-me-in-production

# Lifetime of tokens issued by `npm run login`
JWT_EXPIRES_IN=30d

# Per-connection auth token for the MCP server process. Obtain one by running
# `npm run login` and pasting the printed token here (or into your Claude
# Desktop / Claude Code MCP server config's `env` block).
STUDYGRAPH_USER_TOKEN=

# Only needed to run the live demo (demo/run-demo.ts) and the 6 llm-driven evals, which
# drive a real LLM tool-use loop against the MCP server. Set ANTHROPIC_API_KEY to use
# Claude, or the three NIM_* vars below to use NVIDIA NIM's OpenAI-compatible endpoint
# instead. If both are set, Anthropic takes priority. If neither is set, the demo falls
# back to `npm run demo -- --offline` territory and the llm-driven evals are skipped.
ANTHROPIC_API_KEY=

NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
